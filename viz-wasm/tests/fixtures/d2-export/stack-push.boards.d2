title: stack walkthrough
direction: right

layers: {
  step-1: {
    caption: "for v in values:" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    stack: "Stack — push sequence" {
      grid-columns: 1
      grid-gap: 0
      c0: "10"
    }
    p0: "top" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p0 -> stack.c0: { style.stroke: "#0c7d69" }
  }
  step-2: {
    caption: "for v in values:" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    stack: "Stack — push sequence" {
      grid-columns: 1
      grid-gap: 0
      c0: "10"
      c1: "20" { style.fill: "#e1f4eb"; style.stroke: "#307e57" }
    }
    p0: "top" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p0 -> stack.c1: { style.stroke: "#0c7d69" }
  }
  step-3: {
    caption: "for v in values:" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    stack: "Stack — push sequence" {
      grid-columns: 1
      grid-gap: 0
      c0: "10"
      c1: "20"
      c2: "30" { style.fill: "#e1f4eb"; style.stroke: "#307e57" }
    }
    p0: "top" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p0 -> stack.c2: { style.stroke: "#0c7d69" }
  }
}
