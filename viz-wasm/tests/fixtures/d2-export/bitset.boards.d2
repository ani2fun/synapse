title: bitset walkthrough
direction: right

layers: {
  step-1: {
    caption: "# bits starts all-zero; each op sets (1) or clears (0) one position" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    arr: "Bitset — set & clear" {
      grid-rows: 2
      grid-gap: 0
      c0: "0"
      c1: "0"
      c2: "0"
      c3: "0"
      c4: "0"
      c5: "0"
      c6: "0"
      c7: "0"
      i0: 0 { style.stroke-width: 0; style.fill: transparent; style.font-color: "#6a6f7c"; style.font-size: 13 }
      i1: 1 { style.stroke-width: 0; style.fill: transparent; style.font-color: "#6a6f7c"; style.font-size: 13 }
