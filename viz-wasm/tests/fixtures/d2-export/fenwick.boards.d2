title: fenwick walkthrough
direction: right

layers: {
  step-1: {
    caption: "acc += tree[i]      # tree[i] covers (i - lowbit(i), i]" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    arr: "Fenwick tree (BIT) — prefix-sum query(7)" {
      grid-rows: 2
      grid-gap: 0
      c0: "0"
      c1: "1"
      c2: "3"
      c3: "3"
      c4: "10"
      c5: "5"
      c6: "11"
      c7: "7"
      c8: "36"
