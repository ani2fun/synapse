caption: "visit(cur.value)" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

direction: right
n0: "1"
n1: "2"
n2: "3"
null: null { shape: text; style.font-color: "#6a6f7c" }
n0 -> n1: next
n1 -> n2: next
n2 -> null: next
p0: "head" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
p0 -> n0: { style.stroke: "#0c7d69" }
p1: "cur" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
p1 -> n1: { style.stroke: "#0c7d69" }
