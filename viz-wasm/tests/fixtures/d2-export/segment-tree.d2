caption: "node = node.left if i <= mid else node.right" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

direction: down
n0: "10"
n1: "4"
n2: "3"
n3: "1"
n4: "6"
n5: "4"
n6: "2"
n0 -> n1: "left"
n0 -> n4: "right"
n1 -> n2: "left"
n1 -> n3: "right"
n4 -> n5: "left"
n4 -> n6: "right"
p0: "root" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
p0 -> n0: { style.stroke: "#0c7d69" }
p1: "cur" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
p1 -> n1: { style.stroke: "#0c7d69" }
