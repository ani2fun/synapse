title: hashmap walkthrough
direction: right

layers: {
  step-1: {
    caption: "if idx not in map:" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    map: "(empty)" { style.stroke: "#e5dfd2" }
  }
  step-2: {
    caption: "if entry.key == key:" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    map: {
      grid-columns: 1
      b0: "0" {
        grid-rows: 1
        e0: "apple: 1" { style.fill: "#e1f4eb"; style.stroke: "#307e57" }
      }
    }
  }
  step-3: {
    caption: "if idx not in map:" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    map: {
      grid-columns: 1
      b0: "0" {
        grid-rows: 1
        e0: "apple: 1"
      }
      b1: "1" {
        grid-rows: 1
        e0: "fig: 3" { style.fill: "#e1f4eb"; style.stroke: "#307e57" }
      }
    }
  }
  step-4: {
    caption: "return" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    map: {
      grid-columns: 1
      b0: "0" {
        grid-rows: 1
        e0: "apple: 1"
        e1: "grape: 5" { style.fill: "#e1f4eb"; style.stroke: "#307e57" }
      }
      b1: "1" {
        grid-rows: 1
        e0: "fig: 3"
      }
    }
  }
}
