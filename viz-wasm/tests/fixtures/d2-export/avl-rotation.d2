caption: "node.left = child.right" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

direction: down
n0: "3"
n1: "2"
n2: "1"
n0 -> n1: "left"
n1 -> n2: "left"
p0: "root" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
p0 -> n0: { style.stroke: "#0c7d69" }
p1: "node" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
p1 -> n0: { style.stroke: "#0c7d69" }
p2: "child" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
p2 -> n1: { style.stroke: "#0c7d69" }
