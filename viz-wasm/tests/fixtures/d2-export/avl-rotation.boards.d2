title: tree walkthrough
direction: right

layers: {
  step-1: {
    caption: "# Left-heavy — promote node.left as new root." { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    direction: down
    n0: "3"
    n1: "2"
    n2: "1"
    n0 -> n1: "left"
    n1 -> n2: "left"
    p0: "root" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p0 -> n0: { style.stroke: "#0c7d69" }
    p1: "node" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p1 -> n0: { style.stroke: "#0c7d69" }
  }
  step-2: {
    caption: "node.left = child.right" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    direction: down
    n0: "3"
    n1: "2"
    n2: "1"
    n0 -> n1: "left"
    n1 -> n2: "left"
    p0: "root" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p0 -> n0: { style.stroke: "#0c7d69" }
    p1: "node" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p1 -> n0: { style.stroke: "#0c7d69" }
    p2: "child" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p2 -> n1: { style.stroke: "#0c7d69" }
  }
  step-3: {
    caption: "return child" { shape: text; near: top-center; style.font-color: "#2a303c"; style.font-size: 15 }

    direction: down
    n0: "2"
    n1: "1"
    n2: "3"
    n0 -> n1: "left"
    n0 -> n2: "right"
    p0: "root" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p0 -> n0: { style.stroke: "#0c7d69" }
    p1: "node" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p1 -> n0: { style.stroke: "#0c7d69" }
    p2: "child" { shape: text; style.font-color: "#0c7d69"; style.bold: true }
    p2 -> n0: { style.stroke: "#0c7d69" }
  }
}
