# build output
target/
web/dist/
web/.astro/
node_modules/

# derived code index (CodeGraph rebuilds it per machine; the .db is 8 MB of binary)
.codegraph/

# local-only agent guide (durable design lives in docs/adr/)
CLAUDE.md

# editors / OS
.DS_Store
.idea/
.vscode/

# playwright artefacts (traces/screenshots from failed runs)
e2e/test-results/
e2e/playwright-report/

# coverage output (dev-tools/coverage.sh + vitest --coverage); target/ is already ignored
web/coverage/

# The d2 renderer's compiled binary: `go build` in d2-render/ drops it beside the source, and it
# is ~38 MB. The image builds its own; dev-tools/dev builds into target/.
/d2-render/d2-render
