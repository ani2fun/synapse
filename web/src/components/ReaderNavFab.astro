---
// The Contents FAB for narrow widths. Place it OUTSIDE the reader grid on purpose: a sibling of
// `.reader-layout`, never its third grid child, or it becomes a phantom grid item at desktop
// width. The FAB itself is CSS-hidden at >=1024px (reader.css's `.reader-nav-fab` media rule);
// the drawer it opens clones `.reader-sidebar .reader-sidebar__inner` at click time
// (islands/reader.ts). Shared by the server-rendered lesson and the private shell.
---

<div class="reader-nav">
  <button class="reader-nav-fab" aria-label="Contents" aria-expanded="false" type="button">
    <svg
      class="reader-nav-fab__ic"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="18" height="18" x="3" y="3" rx="2" />
      <path d="M9 3v18 M14 9l3 3-3 3" />
    </svg>
  </button>
</div>
