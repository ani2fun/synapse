#!/usr/bin/env bash
# Run the e2e smoke suite against a PRODUCTION-SHAPED serve: axum (API + headers +
# compression) fronting the Node sidecar via SYNAPSE_ASTRO_URL — the same two processes the
# production image runs. The per-page budget gate runs after the specs, on the same stack.
#
# Needs the backing services from this repo's compose:
#   docker compose up -d db
set -euo pipefail
cd "$(dirname "$0")/.."

export SYNAPSE_DATABASE_URL="${SYNAPSE_DATABASE_URL:-postgres://synapse:synapse@localhost:5532/synapse_rs}"
# The FIXTURE content by default, not ../synapse-content: CI has no content checkout, and a
# smoke suite pinned to real content means an unrelated edit in another repository can turn
# this one red. Point SYNAPSE_ROOT at the real tree to spot-check against it.
export SYNAPSE_ROOT="${SYNAPSE_ROOT:-e2e/fixture-content}"
# A SATELLITE in the library, mounted straight off disk. The registry cannot express a local path
# and the fetcher would reach GitHub, so this is the only way to exercise the multi-source path in
# CI — and it is the same code an author uses to see a guide repo they are editing.
SATELLITE='[{"id":"java-guide","root":"e2e/fixture-java-guide","grouping":"programming-languages","order":7}]'
export SYNAPSE_LOCAL_SOURCES="${SYNAPSE_LOCAL_SOURCES:-$SATELLITE}"
# The reconcile loop is OFF: nothing here is registered, and a tick would only reach the network.
export SYNAPSE_CONTENT_SYNC_SECONDS="${SYNAPSE_CONTENT_SYNC_SECONDS:-0}"
export SYNAPSE_PORT="${SYNAPSE_PORT:-8280}"
SIDECAR_PORT="${SIDECAR_PORT:-4321}"

# shellcheck source=lib-ports.sh
source "$(dirname "$0")/lib-ports.sh"
reclaim "$SYNAPSE_PORT" "synapse-server"

SIDECAR_PID=""
# The viz wasm bundle is gitignored build output the web build imports — build it first
# when absent (dev profile: this proves the graph, the budget gate sizes the release one).
if [[ ! -f web/src/lib/viz-wasm/pkg/viz_wasm.js ]]; then
  ./dev-tools/build-viz-wasm.sh dev
fi
if [[ ! -f web/dist/server/entry.mjs ]]; then
  echo "→ no web/dist — building the Astro app"
  (cd web && npm run build)
fi
# The cluster runs the d2 renderer (ani2fun/infra deployment.yaml) and every figure arrives as
# inline SVG. The main pass runs WITHOUT it anyway, because that is the FALLBACK a dead or
# unreachable sidecar lands in and it is the heavier of the two: it makes the budget below the
# worst case a reader can be served rather than the best. The prod shape follows at the end, in
# the feature's own pass.
#
# Unset, not "off": the address IS the switch, so there is no configuration in which the renderer
# is named and ignored.
unset SYNAPSE_D2_RENDER_URL

D2_RENDER_PORT="${D2_RENDER_PORT:-8391}"
D2_RENDER_PID=""

start_d2_render() {
  reclaim "$D2_RENDER_PORT" "d2-render"
  echo "→ starting the d2 renderer on :$D2_RENDER_PORT"
  go build -C d2-render -o "$PWD/target/d2-render" .
  # A fresh cache per run: a warm one would let a broken renderer pass on last run's figures.
  rm -rf "$PWD/target/e2e-d2-cache"
  D2_RENDER_CACHE="$PWD/target/e2e-d2-cache" D2_RENDER_ADDR=":$D2_RENDER_PORT" \
    ./target/d2-render >/tmp/e2e-d2-render.log 2>&1 &
  D2_RENDER_PID=$!
  for _ in $(seq 1 60); do
    curl -sf "http://127.0.0.1:$D2_RENDER_PORT/healthz" >/dev/null && return 0
    sleep 1
  done
  echo "✗ the d2 renderer never answered on :$D2_RENDER_PORT"; tail -20 /tmp/e2e-d2-render.log; return 1
}

start_sidecar() {
  reclaim "$SIDECAR_PORT" "astro-sidecar"
  echo "→ starting the sidecar on :$SIDECAR_PORT (d2 renderer: ${SYNAPSE_D2_RENDER_URL:-none})"
  # Same pipe hygiene as the server below: log to a file, one PID to clean up.
  HOST=127.0.0.1 PORT="$SIDECAR_PORT" node web/dist/server/entry.mjs >/tmp/e2e-sidecar.log 2>&1 &
  SIDECAR_PID=$!
  for _ in $(seq 1 60); do
    curl -sf "http://127.0.0.1:$SIDECAR_PORT/" >/dev/null && return 0
    sleep 1
  done
  echo "✗ the sidecar never answered — its log:"; sed 's/^/    /' /tmp/e2e-sidecar.log; return 1
}
start_sidecar
export SYNAPSE_ASTRO_URL="http://127.0.0.1:$SIDECAR_PORT"

# Compile FIRST, in the foreground. `cargo run` compiles in the BACKGROUND while the health
# poll counts down — locally the binary is warm so it starts instantly, but on a cold CI cache
# the build takes minutes against a 60-second poll, and the script gives up on a server that is
# still being built.
echo "→ building the server"
cargo build -p synapse-server --quiet

# Run the BINARY, and send its output to a file rather than this script's stdout. Two reasons,
# both learned from the first CI run of this suite, which hung for 39 minutes:
#   · CI runs `dev-tools/e2e | tee`, and a background process that inherits the pipe keeps its
#     write end open after this script exits — `tee` never sees EOF and the step never ends.
#   · `cargo run` spawns children; killing cargo can leave rustc/the server behind holding that
#     same pipe. Exec'ing the built binary means there is exactly one PID to clean up.
#
# A FUNCTION because the d2 pass restarts it: the board proxy is mounted from
# SYNAPSE_D2_RENDER_URL at boot, so a server started without it serves the fallback shape no
# matter what the page tier does — which is exactly the prod requirement, both halves or neither.
start_server() {
  echo "→ starting the server on :$SYNAPSE_PORT (d2 renderer: ${SYNAPSE_D2_RENDER_URL:-none})"
  ./target/debug/synapse-server >/tmp/e2e-server.log 2>&1 &
  SERVER_PID=$!
  for _ in $(seq 1 60); do
    curl -sf "http://localhost:$SYNAPSE_PORT/api/health" >/dev/null && return 0
    sleep 1
  done
  echo "✗ the server never became ready — its log:"
  sed 's/^/    /' /tmp/e2e-server.log
  return 1
}

start_server
trap 'kill "$SERVER_PID" 2>/dev/null || true; [[ -n "$SIDECAR_PID" ]] && kill "$SIDECAR_PID" 2>/dev/null || true; [[ -n "$D2_RENDER_PID" ]] && kill "$D2_RENDER_PID" 2>/dev/null || true' EXIT


if [[ -n "$SIDECAR_PID" ]]; then
  # The page path must actually flow through the proxy before the suite starts.
  curl -sf "http://localhost:$SYNAPSE_PORT/" >/dev/null || {
    echo "✗ the proxied Astro root never answered — sidecar log:"
    sed 's/^/    /' /tmp/e2e-sidecar.log
    exit 1
  }
fi

cd e2e
[[ -d node_modules ]] || npm ci

# Not `exec`: on failure we want to describe what the server was actually serving, and after
# `exec` the EXIT trap has already killed it. A CI-only boot failure otherwise shows up as
# "element(s) not found" with nothing to explain why.
set +e
npx playwright test "$@"
PW_STATUS=$?
set -e
cd ..

if [[ $PW_STATUS -ne 0 ]]; then
  echo
  echo "── the server was serving this ──"
  echo "  root page assets:"
  for a in $(curl -s "http://localhost:$SYNAPSE_PORT/" | grep -oE '(assets|_astro)/[A-Za-z0-9_.-]+' | sort -u); do
    echo "    $a -> $(curl -s -o /dev/null -w '%{http_code} %{content_type} %{size_download}B' \
      "http://localhost:$SYNAPSE_PORT/$a")"
  done
  echo "  server log (tail):"
  tail -30 /tmp/e2e-server.log | sed 's/^/    /' || true
  [[ -n "$SIDECAR_PID" ]] && { echo "  sidecar log (tail):"; tail -20 /tmp/e2e-sidecar.log | sed 's/^/    /' || true; }
  exit $PW_STATUS
fi

# ── the per-page budget — while the stack is still up ──
# Measured with pre-rendering OFF, so the recorded numbers are the most a reader can be asked to
# pay: an un-drawn fence falls back here, and the fallback ships the engine.
dev-tools/check-page-budget.sh "http://localhost:$SYNAPSE_PORT"

# ── the d2 pre-render pass — the shape the cluster serves ─────────────────────
# The main pass above ran the fallback, so without this the path the cluster actually serves
# would never be exercised at all. Only its own spec re-runs, against a sidecar restarted
# with the switch on; the same file asserts the fallback shape in the main pass above, so both
# modes are covered and neither can silently become the other.
# Skipped when the caller filtered the suite — `dev-tools/e2e frames` means "just that one".
if [[ $# -eq 0 ]]; then
  echo
  echo "→ re-running the d2 spec with the renderer UP"
  kill "$SIDECAR_PID" 2>/dev/null || true
  wait "$SIDECAR_PID" 2>/dev/null || true
  kill "$SERVER_PID" 2>/dev/null || true
  wait "$SERVER_PID" 2>/dev/null || true
  start_d2_render
  export SYNAPSE_D2_RENDER_URL="http://127.0.0.1:$D2_RENDER_PORT"
  # BOTH halves, or the reader gets a drawn root board whose links 404: the page tier inlines the
  # root, and the server proxies every board behind it.
  start_server
  start_sidecar
  set +e
  (cd e2e && npx playwright test d2-prerender)
  PRERENDER_STATUS=$?
  set -e
  if [[ $PRERENDER_STATUS -ne 0 ]]; then
    echo "  sidecar log (tail):"; tail -20 /tmp/e2e-sidecar.log | sed 's/^/    /' || true
    exit $PRERENDER_STATUS
  fi
fi
