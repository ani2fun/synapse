{
  "realm": "synapse",
  "displayName": "Synapse (local)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "loginTheme": "synapse",
  "clients": [
    {
      "clientId": "synapse-web",
      "name": "Synapse SPA",
      "description": "Public PKCE client for the Synapse SPA (step 17, ADR-S024).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5273/*",
        "http://localhost:8180/*",
        "http://localhost:5373/*",
        "http://localhost:8280/*"
      ],
      "webOrigins": [
        "http://localhost:5273",
        "http://localhost:8180",
        "http://localhost:5373",
        "http://localhost:8280"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5273/*##http://localhost:8180/*##http://localhost:5373/*##http://localhost:8280/*"
      }
    },
    {
      "clientId": "synapse-admin",
      "name": "Synapse account-admin (service account)",
      "description": "Confidential service-account client the server uses for account deletion (step 37) — client_credentials, scoped to realm-management:manage-users only. NOT the master admin.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-admin-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "tester",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Synapse",
      "lastName": "Tester",
      "email": "tester@synapse.local",
      "credentials": [{ "type": "password", "value": "tester", "temporary": false }]
    },
    {
      "username": "test1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Synapse",
      "lastName": "TestOne",
      "email": "test1@synapse.local",
      "credentials": [{ "type": "password", "value": "test1", "temporary": false }]
    },
    {
      "username": "service-account-synapse-admin",
      "enabled": true,
      "serviceAccountClientId": "synapse-admin",
      "clientRoles": { "realm-management": ["manage-users"] }
    }
  ]
}
