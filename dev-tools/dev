#!/usr/bin/env bash
# ── DEV LOOP ─────────────────────────────────────────────────────────────────
# axum API on :8280 (background) + Astro dev on :5373 (foreground, HMR, proxies
# /api /media /c4). Ctrl-C stops both. :5373 is pinned by the Keycloak dev realm
# origin allowlist — a silent port bump 403s the silent-SSO iframe.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "──────────────────────────────────────────────────────────"
echo "  synapse dev loop"
echo "  branch: $(git branch --show-current)   api :${SYNAPSE_PORT:-8280}   web :5373"
echo "──────────────────────────────────────────────────────────"


# shellcheck source=lib-ports.sh
source "$(dirname "$0")/lib-ports.sh"
reclaim "${SYNAPSE_PORT:-8280}" "synapse-server"
reclaim 5373 "astro-dev"

# The viz wasm bundle (A10): Vite resolves the lazy import on demand, so a missing pkg only
# explodes the first time a page actually loads viz — build it up front (dev profile, seconds
# when warm) so the loop never serves that surprise.
if [[ ! -f web/src/lib/viz-wasm/pkg/viz_wasm.js ]]; then
  ./dev-tools/build-viz-wasm.sh dev
fi

# Vite's dependency pre-scan runs ONLY when web/node_modules/.vite/deps is absent, and it is the
# one step that reads every .astro through a regex script-block extractor. A warm cache skips it,
# so a file that breaks the scan boots fine here and explodes on the next machine to start cold.
# Wiping it makes every dev start the cold path: the scan runs, and a break shows up now.
rm -rf web/node_modules/.vite/deps

# `render-local-only` renders `local-only-content/` — study material that is gitignored and must
# never be served. A cargo feature rather than an env var on purpose: the production binary does
# not contain the branch at all, so ADR-RS002's guarantee stays structural. Only this loop enables
# it, and check-conventions.sh asserts the image build does not.
cargo build -p synapse-server --features render-local-only --quiet
./target/debug/synapse-server &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true' EXIT

cd web && exec npx astro dev
