#!/usr/bin/env bash
# ── SCAFFOLD A CONTENT REPOSITORY ─────────────────────────────────────────────
# Lays out a satellite guide repo that Synapse can mount: the root IS the book, chapters sit
# directly under it, and book.json carries the identity. The generated tree renders as-is and
# passes dev-tools/validate-book, so a new maintainer starts from something that works rather
# than from a contract they have to reverse-engineer.
#
#   dev-tools/new-book <slug> [target-dir]
#
# The slug is the URL segment and is IMMUTABLE once published — every link and media path embeds
# it. Where the book sits in the library is not decided here: an admin registers the repository
# and sets its grouping.
set -euo pipefail
cd "$(dirname "$0")/.."

SLUG="${1:-}"
if [[ -z "$SLUG" ]]; then
  echo "usage: dev-tools/new-book <slug> [target-dir]" >&2
  exit 1
fi
if [[ ! "$SLUG" =~ ^[a-z0-9]([a-z0-9_-]*[a-z0-9])?$ ]]; then
  echo "✗ '$SLUG' is not slug-like — lowercase alphanumerics, '-' and '_' only" >&2
  exit 1
fi
DIR="${2:-../${SLUG}-guide}"
if [[ -e "$DIR" ]]; then
  echo "✗ $DIR already exists" >&2
  exit 1
fi
TITLE="$(echo "$SLUG" | tr -- '-_' '  ' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)}1')"

mkdir -p "$DIR"/{01-getting-started,02-problems/01-sum-of-array-elements,_media/"$SLUG"}

cat > "$DIR/book.json" <<JSON
{
    "title": "$TITLE",
    "description": "One paragraph. This is the blurb on the library card.",
    "tags": ["$SLUG"],
    "estimatedReadingMinutes": 60,
    "slug": "$SLUG"
}
JSON

cat > "$DIR/00-index.md" <<'MD'
---
title: Introduction
summary: What this book is for, and how to read it.
---

# Introduction

Open with the one idea the whole book is built on. A reader who stops here should still leave
knowing what the subject is *for*.

## How to read this

- Chapters are directories, lessons are `.md` files, and both are ordered by their `NN-` prefix.
- The prefix is stripped from the URL: `01-getting-started/02-variables.md` is served at
  `…/getting-started/variables`.
- `index.md` sorts first within its level; anything unnumbered sorts last, alphabetically.
